# 复制为 .env.local 后填写。.env.local 已被 .gitignore 忽略，不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 可选，默认 https://api.deepseek.com
# 本地自测可指向 mock：http://127.0.0.1:8787（见 scripts/mock-deepseek.mjs）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：公网部署时填写，用于生成 OG / Twitter 分享图的绝对地址。
# 不填时使用请求域名；本地开发为 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=

# 可选：AI 接口限流取 IP 时信任的反向代理层数（从 X-Forwarded-For 右侧数）。
# 默认 1，适用于 Nginx / Vercel / Cloudflare 单层代理；
# CDN + Nginx 两层填 2。客户端自己写在最左侧的地址永远不会被采信。
TRUSTED_PROXY_HOPS=1
